{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "primitive": {
    "color": {
      "neutral": {
        "0": { "$value": "#FFFFFF" },
        "50": { "$value": "#F5F6F7" },
        "100": { "$value": "#E4E7EB" },
        "200": { "$value": "#D7DCE2" },
        "300": { "$value": "#C7CCD2" },
        "400": { "$value": "#A6ADB7" },
        "500": { "$value": "#858C96" },
        "600": { "$value": "#5E646E" },
        "700": { "$value": "#343941" },
        "800": { "$value": "#24272D" },
        "850": { "$value": "#17191D" },
        "900": { "$value": "#101114" },
        "950": { "$value": "#090A0C" }
      }
    }
  },
  "semantic": {
    "light": {
      "background": {
        "primary": { "$value": "{primitive.color.neutral.0}" },
        "secondary": { "$value": "{primitive.color.neutral.50}" }
      },
      "surface": {
        "default": { "$value": "{primitive.color.neutral.50}" },
        "elevated": { "$value": "{primitive.color.neutral.0}" }
      },
      "text": {
        "primary": { "$value": "{primitive.color.neutral.900}" },
        "secondary": { "$value": "{primitive.color.neutral.600}" },
        "muted": { "$value": "{primitive.color.neutral.600}" },
        "inverse": { "$value": "{primitive.color.neutral.0}" }
      },
      "border": {
        "default": { "$value": "{primitive.color.neutral.500}" },
        "subtle": { "$value": "{primitive.color.neutral.200}" }
      },
      "action": {
        "primary": { "$value": "{primitive.color.neutral.700}" },
        "primaryHover": { "$value": "{primitive.color.neutral.800}" },
        "primaryText": { "$value": "{primitive.color.neutral.50}" }
      },
      "focus": {
        "ring": { "$value": "{primitive.color.neutral.700}" }
      }
    },
    "dark": {
      "background": {
        "primary": { "$value": "{primitive.color.neutral.950}" },
        "secondary": { "$value": "{primitive.color.neutral.900}" }
      },
      "surface": {
        "default": { "$value": "{primitive.color.neutral.850}" },
        "elevated": { "$value": "{primitive.color.neutral.800}" }
      },
      "text": {
        "primary": { "$value": "{primitive.color.neutral.50}" },
        "secondary": { "$value": "#B8BEC7" },
        "muted": { "$value": "{primitive.color.neutral.400}" },
        "inverse": { "$value": "{primitive.color.neutral.950}" }
      },
      "border": {
        "default": { "$value": "#42464E" },
        "subtle": { "$value": "#30343B" }
      },
      "action": {
        "primary": { "$value": "{primitive.color.neutral.300}" },
        "primaryHover": { "$value": "{primitive.color.neutral.100}" },
        "primaryText": { "$value": "{primitive.color.neutral.950}" }
      },
      "focus": {
        "ring": { "$value": "{primitive.color.neutral.300}" }
      }
    }
  },
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "{semantic.light.background.primary}" },
      "foreground": { "$value": "{semantic.light.text.primary}" },
      "border": { "$value": "{semantic.light.border.default}" },
      "card": { "$value": "{semantic.light.surface.default}" },
      "cardForeground": { "$value": "{semantic.light.text.primary}" },
      "popover": { "$value": "{semantic.light.surface.elevated}" },
      "popoverForeground": { "$value": "{semantic.light.text.primary}" },
      "primary": {
        "$value": "{semantic.light.action.primary}",
        "$description": "Silver-chrome action surface, paired with dark text."
      },
      "primaryForeground": { "$value": "{semantic.light.action.primaryText}" },
      "secondary": { "$value": "{primitive.color.neutral.100}" },
      "secondaryForeground": { "$value": "{primitive.color.neutral.900}" },
      "muted": { "$value": "{primitive.color.neutral.50}" },
      "mutedForeground": { "$value": "{semantic.light.text.muted}" },
      "accent": { "$value": "{primitive.color.neutral.200}" },
      "accentForeground": { "$value": "{primitive.color.neutral.900}" },
      "destructive": { "$value": "#B42318" },
      "destructiveForeground": { "$value": "{primitive.color.neutral.0}" },
      "input": { "$value": "{primitive.color.neutral.400}" },
      "ring": { "$value": "{semantic.light.focus.ring}" },
      "chart1": { "$value": "#1D4ED8" },
      "chart2": { "$value": "#047857" },
      "chart3": { "$value": "#854D0E" },
      "chart4": { "$value": "#B42318" },
      "chart5": { "$value": "{primitive.color.neutral.600}" },
      "sidebar": { "$value": "{primitive.color.neutral.50}" },
      "sidebarForeground": { "$value": "{primitive.color.neutral.900}" },
      "sidebarBorder": { "$value": "#A6ADB7" },
      "sidebarPrimary": { "$value": "{primitive.color.neutral.700}" },
      "sidebarPrimaryForeground": { "$value": "{primitive.color.neutral.50}" },
      "sidebarAccent": { "$value": "{primitive.color.neutral.100}" },
      "sidebarAccentForeground": { "$value": "{primitive.color.neutral.900}" },
      "sidebarRing": { "$value": "{primitive.color.neutral.700}" }
    },
    "dark": {
      "background": { "$value": "{semantic.dark.background.primary}" },
      "foreground": { "$value": "{semantic.dark.text.primary}" },
      "border": { "$value": "{semantic.dark.border.default}" },
      "card": { "$value": "{semantic.dark.surface.default}" },
      "cardForeground": { "$value": "{semantic.dark.text.primary}" },
      "popover": { "$value": "{semantic.dark.surface.elevated}" },
      "popoverForeground": { "$value": "{semantic.dark.text.primary}" },
      "primary": { "$value": "{semantic.dark.action.primary}" },
      "primaryForeground": { "$value": "{semantic.dark.action.primaryText}" },
      "secondary": { "$value": "{primitive.color.neutral.800}" },
      "secondaryForeground": { "$value": "{primitive.color.neutral.50}" },
      "muted": { "$value": "{primitive.color.neutral.800}" },
      "mutedForeground": { "$value": "{semantic.dark.text.muted}" },
      "accent": { "$value": "{primitive.color.neutral.700}" },
      "accentForeground": { "$value": "{primitive.color.neutral.50}" },
      "destructive": { "$value": "#F87171" },
      "destructiveForeground": { "$value": "{primitive.color.neutral.950}" },
      "input": { "$value": "#42464E" },
      "ring": { "$value": "{semantic.dark.focus.ring}" },
      "chart1": { "$value": "#60A5FA" },
      "chart2": { "$value": "#34D399" },
      "chart3": { "$value": "#FBBF24" },
      "chart4": { "$value": "#F87171" },
      "chart5": { "$value": "{primitive.color.neutral.400}" },
      "sidebar": { "$value": "{primitive.color.neutral.900}" },
      "sidebarForeground": { "$value": "{primitive.color.neutral.50}" },
      "sidebarBorder": { "$value": "#30343B" },
      "sidebarPrimary": { "$value": "{primitive.color.neutral.300}" },
      "sidebarPrimaryForeground": { "$value": "{primitive.color.neutral.950}" },
      "sidebarAccent": { "$value": "{primitive.color.neutral.800}" },
      "sidebarAccentForeground": { "$value": "{primitive.color.neutral.50}" },
      "sidebarRing": { "$value": "{primitive.color.neutral.300}" }
    }
  },
  "status": {
    "light": {
      "success": { "$value": "#047857" },
      "warning": { "$value": "#854D0E" },
      "error": { "$value": "#B42318" },
      "info": { "$value": "#1D4ED8" },
      "neutral": { "$value": "#5E646E" }
    },
    "dark": {
      "success": { "$value": "#34D399" },
      "warning": { "$value": "#FBBF24" },
      "error": { "$value": "#F87171" },
      "info": { "$value": "#60A5FA" },
      "neutral": { "$value": "#A6ADB7" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "Noto Sans Myanmar", "Myanmar Text", "sans-serif"],
        "$description": "Inter for Latin UI, with Noto Sans Myanmar and system fallbacks for Burmese text."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["JetBrains Mono", "monospace"] }
    },
    "scale": {
      "display": {
        "fontSize": { "$value": "40px" },
        "lineHeight": { "$value": "48px" }
      },
      "headingXL": {
        "fontSize": { "$value": "32px" },
        "lineHeight": { "$value": "40px" }
      },
      "headingLG": {
        "fontSize": { "$value": "24px" },
        "lineHeight": { "$value": "32px" }
      },
      "headingMD": {
        "fontSize": { "$value": "20px" },
        "lineHeight": { "$value": "28px" }
      },
      "bodyLG": {
        "fontSize": { "$value": "18px" },
        "lineHeight": { "$value": "28px" }
      },
      "bodyMD": {
        "fontSize": { "$value": "16px" },
        "lineHeight": { "$value": "24px" }
      },
      "bodySM": {
        "fontSize": { "$value": "14px" },
        "lineHeight": { "$value": "20px" }
      },
      "label": {
        "fontSize": { "$value": "14px" },
        "lineHeight": { "$value": "20px" }
      },
      "caption": {
        "fontSize": { "$value": "12px" },
        "lineHeight": { "$value": "16px" }
      }
    },
    "fontWeight": {
      "regular": { "$value": "400" },
      "medium": { "$value": "500" },
      "semibold": { "$value": "600" },
      "bold": { "$value": "700" }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "12px",
      "$description": "Base control and card radius."
    },
    "scale": {
      "xs": { "$value": "4px" },
      "sm": { "$value": "8px" },
      "md": { "$value": "12px" },
      "lg": { "$value": "16px" },
      "xl": { "$value": "24px" },
      "pill": { "$value": "999px" }
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "4px",
      "$description": "Four-pixel base spacing step."
    },
    "scale": {
      "0": { "$value": "0px" },
      "1": { "$value": "4px" },
      "2": { "$value": "8px" },
      "3": { "$value": "12px" },
      "4": { "$value": "16px" },
      "5": { "$value": "20px" },
      "6": { "$value": "24px" },
      "8": { "$value": "32px" },
      "10": { "$value": "40px" },
      "12": { "$value": "48px" },
      "16": { "$value": "64px" }
    }
  },
  "sizing": {
    "icon": {
      "sm": { "$value": "16px" },
      "md": { "$value": "20px" },
      "lg": { "$value": "24px" }
    },
    "control": {
      "sm": { "$value": "36px" },
      "md": { "$value": "44px" },
      "lg": { "$value": "48px" }
    },
    "border": {
      "thin": { "$value": "1px" },
      "focus": { "$value": "2px" }
    }
  },
  "motion": {
    "fast": { "$value": "120ms" },
    "normal": { "$value": "200ms" },
    "slow": { "$value": "300ms" }
  },
  "breakpoint": {
    "smallMobile": { "$value": "320px" },
    "mobile": { "$value": "360px" },
    "tablet": { "$value": "768px" },
    "desktop": { "$value": "1024px" },
    "wideDesktop": { "$value": "1440px" }
  }
}
