{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#edf3f8" },
      "foreground": { "$value": "#101b28" },
      "border": { "$value": "#c9d6e2" },
      "card": { "$value": "#f8fbfe" },
      "cardForeground": { "$value": "#101b28" },
      "popover": { "$value": "#f8fbfe" },
      "popoverForeground": { "$value": "#101b28" },
      "primary": {
        "$value": "#176797",
        "$description": "Primary brand blue, sampled from the supplied RZ Builder logo."
      },
      "primaryForeground": { "$value": "#f8fcff" },
      "secondary": { "$value": "#dce7f0" },
      "secondaryForeground": { "$value": "#19364d" },
      "muted": { "$value": "#e3ebf2" },
      "mutedForeground": { "$value": "#526779" },
      "accent": { "$value": "#d4f6ff" },
      "accentForeground": { "$value": "#064563" },
      "destructive": { "$value": "#b4233e" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#c1d1df" },
      "ring": { "$value": "#168cc5" },
      "chart1": { "$value": "#176797" },
      "chart2": { "$value": "#12a8c5" },
      "chart3": { "$value": "#536f8a" },
      "chart4": { "$value": "#4b91cc" },
      "chart5": { "$value": "#1a596b" },
      "sidebar": { "$value": "#e5edf4" },
      "sidebarForeground": { "$value": "#253e53" },
      "sidebarBorder": { "$value": "#c9d6e2" },
      "sidebarPrimary": { "$value": "#176797" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#d4f6ff" },
      "sidebarAccentForeground": { "$value": "#064563" },
      "sidebarRing": { "$value": "#168cc5" }
    },
    "dark": {
      "background": { "$value": "#05080d" },
      "foreground": { "$value": "#eaf4ff" },
      "border": { "$value": "#243b51" },
      "card": { "$value": "#0b1420" },
      "cardForeground": { "$value": "#eaf4ff" },
      "popover": { "$value": "#0b1420" },
      "popoverForeground": { "$value": "#eaf4ff" },
      "primary": { "$value": "#72caff" },
      "primaryForeground": { "$value": "#05111c" },
      "secondary": { "$value": "#142538" },
      "secondaryForeground": { "$value": "#d5eaff" },
      "muted": { "$value": "#101d2b" },
      "mutedForeground": { "$value": "#9ab0c5" },
      "accent": { "$value": "#0c344b" },
      "accentForeground": { "$value": "#b9f3ff" },
      "destructive": { "$value": "#a92e45" },
      "destructiveForeground": { "$value": "#fff5f6" },
      "input": { "$value": "#2d4a63" },
      "ring": { "$value": "#4bdfff" },
      "chart1": { "$value": "#72caff" },
      "chart2": { "$value": "#34d9ff" },
      "chart3": { "$value": "#b7c7d8" },
      "chart4": { "$value": "#4288c5" },
      "chart5": { "$value": "#39b9a8" },
      "sidebar": { "$value": "#080f18" },
      "sidebarForeground": { "$value": "#e2effb" },
      "sidebarBorder": { "$value": "#1d3348" },
      "sidebarPrimary": { "$value": "#31c9f5" },
      "sidebarPrimaryForeground": { "$value": "#03131c" },
      "sidebarAccent": { "$value": "#10263a" },
      "sidebarAccentForeground": { "$value": "#d8f8ff" },
      "sidebarRing": { "$value": "#4bdfff" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Space Grotesk", "sans-serif"],
        "$description": "A technical but readable UI face for build workflows and product copy."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["JetBrains Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.625rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
